{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["bun", "node", "react", "react-dom"]
  },
  "include": ["rakun.config.ts", "seed.ts", "src/**/*.ts", "src/**/*.tsx"]
}
