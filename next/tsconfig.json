{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "rootDir": "..",
    "outDir": "dist",
    "noEmit": true,
    "paths": {
      "@rakun-kit/core": ["../core/src/index.ts"],
      "@rakun-kit/core/contracts": ["../core/src/contracts.ts"],
      "@rakun-kit/core/literals": ["../core/src/literals/index.ts"],
      "@rakun-kit/core/web": ["../core/src/web/index.ts"],
      "@rakun-kit/core/errors": ["../core/src/lib/errors/index.ts"],
      "@rakun-kit/core/logger": ["../core/src/lib/Logger.ts"],
      "@rakun-kit/core/internal-content-types": [
        "../core/src/internal-content-types/index.ts"
      ],
      "@rakun-kit/manager-react": ["../manager-react/src/index.ts"],
      "@rakun-kit/manager-react/seo": ["../manager-react/src/seo/index.ts"],
      "@rakun-kit/manager-react/client/http": [
        "../manager-react/src/client/http.ts"
      ],
      "@rakun-kit/manager-react/client/request": [
        "../manager-react/src/client/request.ts"
      ],
      "@rakun-kit/manager-react/app/runtime-app": [
        "../manager-react/src/app/runtime-app.tsx"
      ],
      "@rakun-kit/manager-react/state/theme-script": [
        "../manager-react/src/state/theme-script.tsx"
      ],
      "@rakun-kit/manager-react/styles.css": [
        "../manager-react/styles.css.d.ts"
      ],
      "@rakun-kit/manager-react/link": ["../manager-react/src/link.tsx"],
      "@rakun-kit/react": ["../react/src/index.ts"],
      "@rakun-kit/react/devtools": ["../react/src/devtools.ts"],
      "@rakun-kit/react/translation": ["../react/src/translation.ts"],
      "@rakun-kit/trpc": ["../trpc/src/index.ts"]
    }
  },
  "include": ["src"]
}
