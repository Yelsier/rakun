{
  "name": "@rakun-kit/next",
  "version": "1.3.6",
  "description": "Next.js adapter for Rakun APIs, manager UI, and media endpoints.",
  "license": "MIT",
  "author": {
    "name": "Yago Claros",
    "url": "https://github.com/Yelsier"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yelsier/rakun.git",
    "directory": "next"
  },
  "bugs": {
    "url": "https://github.com/Yelsier/rakun/issues"
  },
  "homepage": "https://github.com/Yelsier/rakun/tree/main/next#readme",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && bun run build:esm && bun run build:cjs",
    "build:esm": "tsc -b --force tsconfig.build.json && node ../scripts/fix-dist-imports.mjs dist/esm && node ./scripts/write-manager-client-shim.mjs",
    "build:cjs": "rm -rf dist/cjs && tsc -p tsconfig.build.cjs.json && node ../scripts/write-cjs-package-json.mjs dist/cjs"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@rakun-kit/core": "^1.3.5",
    "@rakun-kit/react": "^1.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.2"
  },
  "peerDependencies": {
    "@rakun-kit/manager-react": "^1.2.0",
    "@rakun-kit/trpc": "^1.0.0",
    "@trpc/server": "^11.10.0",
    "next": ">=13.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@rakun-kit/manager-react": {
      "optional": true
    },
    "@rakun-kit/trpc": {
      "optional": true
    },
    "@trpc/server": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./trpc": {
      "types": "./dist/esm/trpc.d.ts",
      "import": "./dist/esm/trpc.js",
      "require": "./dist/cjs/trpc.js",
      "default": "./dist/esm/trpc.js"
    },
    "./media": {
      "types": "./dist/esm/media.d.ts",
      "import": "./dist/esm/media.js",
      "require": "./dist/cjs/media.js",
      "default": "./dist/esm/media.js"
    },
    "./web": {
      "types": "./dist/esm/web.d.ts",
      "import": "./dist/esm/web.js",
      "require": "./dist/cjs/web.js",
      "default": "./dist/esm/web.js"
    },
    "./web/client": {
      "types": "./dist/esm/web-client.d.ts",
      "import": "./dist/esm/web-client.js",
      "require": "./dist/cjs/web-client.js",
      "default": "./dist/esm/web-client.js"
    },
    "./translation": {
      "types": "./dist/esm/translation.d.ts",
      "import": "./dist/esm/translation.js",
      "require": "./dist/cjs/translation.js",
      "default": "./dist/esm/translation.js"
    },
    "./manager": {
      "types": "./dist/esm/manager.d.ts",
      "import": "./dist/esm/manager.js",
      "require": "./dist/cjs/manager.js",
      "default": "./dist/esm/manager.js"
    },
    "./internal-content-types": {
      "types": "./dist/esm/internal-content-types.d.ts",
      "import": "./dist/esm/internal-content-types.js",
      "require": "./dist/cjs/internal-content-types.js",
      "default": "./dist/esm/internal-content-types.js"
    }
  }
}
