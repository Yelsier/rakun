{
  "name": "@rakun-kit/core",
  "version": "1.4.9",
  "description": "Core Rakun content, routing, media, auth, and manager APIs.",
  "license": "MIT",
  "author": {
    "name": "Yago Claros",
    "url": "https://github.com/Yelsier"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yelsier/rakun.git",
    "directory": "core"
  },
  "bugs": {
    "url": "https://github.com/Yelsier/rakun/issues"
  },
  "homepage": "https://github.com/Yelsier/rakun/tree/main/core#readme",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && bun run build:esm && bun run build:cjs",
    "build:esm": "tsc -b --force tsconfig.build.json && node ../scripts/fix-dist-imports.mjs dist/esm",
    "build:cjs": "rm -rf dist/cjs && tsc -p tsconfig.build.cjs.json && node ../scripts/write-cjs-package-json.mjs dist/cjs",
    "test": "bun test --max-concurrency=1 --timeout=30000"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@simplewebauthn/server": "^13.3.0",
    "otpauth": "^9.5.0",
    "qrcode": "^1.5.4",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "bcrypt": "^6.0.0",
    "sharp": "^0.34.5",
    "mongodb": "^7.1.1"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./logger": {
      "types": "./dist/esm/lib/Logger.d.ts",
      "import": "./dist/esm/lib/Logger.js",
      "require": "./dist/cjs/lib/Logger.js",
      "default": "./dist/esm/lib/Logger.js"
    },
    "./errors": {
      "types": "./dist/esm/lib/errors/index.d.ts",
      "import": "./dist/esm/lib/errors/index.js",
      "require": "./dist/cjs/lib/errors/index.js",
      "default": "./dist/esm/lib/errors/index.js"
    },
    "./contracts": {
      "types": "./dist/esm/contracts.d.ts",
      "import": "./dist/esm/contracts.js",
      "require": "./dist/cjs/contracts.js",
      "default": "./dist/esm/contracts.js"
    },
    "./literals": {
      "types": "./dist/esm/literals/index.d.ts",
      "import": "./dist/esm/literals/index.js",
      "require": "./dist/cjs/literals/index.js",
      "default": "./dist/esm/literals/index.js"
    },
    "./api-utils": {
      "types": "./dist/esm/api/utils/index.d.ts",
      "import": "./dist/esm/api/utils/index.js",
      "require": "./dist/cjs/api/utils/index.js",
      "default": "./dist/esm/api/utils/index.js"
    },
    "./web": {
      "types": "./dist/esm/web/index.d.ts",
      "import": "./dist/esm/web/index.js",
      "require": "./dist/cjs/web/index.js",
      "default": "./dist/esm/web/index.js"
    },
    "./manager": {
      "types": "./dist/esm/manager.d.ts",
      "import": "./dist/esm/manager.js",
      "require": "./dist/cjs/manager.js",
      "default": "./dist/esm/manager.js"
    },
    "./client": {
      "types": "./dist/esm/client.d.ts",
      "import": "./dist/esm/client.js",
      "require": "./dist/cjs/client.js",
      "default": "./dist/esm/client.js"
    },
    "./internal-content-types": {
      "types": "./dist/esm/internal-content-types/index.d.ts",
      "import": "./dist/esm/internal-content-types/index.js",
      "require": "./dist/cjs/internal-content-types/index.js",
      "default": "./dist/esm/internal-content-types/index.js"
    },
    "./internal-content-types/*": {
      "types": "./dist/esm/internal-content-types/*.d.ts",
      "import": "./dist/esm/internal-content-types/*.js",
      "require": "./dist/cjs/internal-content-types/*.js",
      "default": "./dist/esm/internal-content-types/*.js"
    },
    "./types": {
      "types": "./dist/esm/lib/types/index.d.ts",
      "import": "./dist/esm/lib/types/index.js",
      "require": "./dist/cjs/lib/types/index.js",
      "default": "./dist/esm/lib/types/index.js"
    },
    "./plugins": {
      "types": "./dist/esm/plugins.d.ts",
      "import": "./dist/esm/plugins.js",
      "require": "./dist/cjs/plugins.js",
      "default": "./dist/esm/plugins.js"
    }
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "^1.3.13",
    "@types/qrcode": "^1.5.6",
    "bcrypt": "^6.0.0",
    "mongodb": "^7.1.1",
    "sharp": "^0.34.5"
  }
}
