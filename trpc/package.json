{
  "name": "@rakun-kit/trpc",
  "version": "1.0.0",
  "description": "tRPC adapter for Rakun manager and web operations.",
  "license": "MIT",
  "author": {
    "name": "Yago Claros",
    "url": "https://github.com/Yelsier"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yelsier/rakun.git",
    "directory": "trpc"
  },
  "bugs": {
    "url": "https://github.com/Yelsier/rakun/issues"
  },
  "homepage": "https://github.com/Yelsier/rakun/tree/main/trpc#readme",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -b --force tsconfig.build.json && node ../scripts/fix-dist-imports.mjs dist/esm",
    "build:cjs": "rm -rf dist/cjs && tsc -p tsconfig.build.cjs.json && node ../scripts/write-cjs-package-json.mjs dist/cjs"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@rakun-kit/core": "^1.0.0",
    "@trpc/server": "^11.10.0",
    "superjson": "^2.2.6",
    "zod": "^4.3.6"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  }
}
