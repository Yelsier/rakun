{
  "name": "@rakun-kit/preview",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "concurrently -k -n css,web -c cyan,magenta \"bun run --filter @rakun-kit/manager-react build:css:watch\" \"bun run dev:web:only\"",
    "dev:web:only": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rakun-kit/core": "^1.2.1",
    "@rakun-kit/express": "^1.0.0",
    "@rakun-kit/manager-locales": "^1.0.0",
    "@rakun-kit/manager-react": "^1.0.0",
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "mongodb": "^7.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "tsx": "^4.21.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^6.0.2",
    "vite": "^8.0.8"
  }
}
