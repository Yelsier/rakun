{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["../manager-react/src/*"],
      "@rakun/core": ["../core/src/index.ts"],
      "@rakun/core/client": ["../core/src/client.ts"],
      "@rakun/core/contracts": ["../core/src/contracts.ts"],
      "@rakun/core/manager": ["../core/src/manager.ts"],
      "@rakun/core/internal-content-types": [
        "../core/src/internal-content-types/index.ts"
      ],
      "@rakun/core/internal-content-types/*": [
        "../core/src/internal-content-types/*.ts"
      ],
      "@rakun/core/lib/*": ["../core/src/lib/*.ts"],
      "@rakun/core/lib/fields/*": ["../core/src/lib/fields/*.ts"],
      "@rakun/core/lib/utils/*": ["../core/src/lib/utils/*.ts"],
      "@rakun/core/types": ["../core/src/lib/types/index.ts"],
      "@rakun/manager-react": ["../manager-react/src/index.ts"],
      "@rakun/manager-react/*": ["../manager-react/src/*"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "server", "vite.config.ts"]
}
