{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["../manager-react/src/*"],
      "@rakun-kit/core": ["../core/src/index.ts"],
      "@rakun-kit/core/client": ["../core/src/client.ts"],
      "@rakun-kit/core/contracts": ["../core/src/contracts.ts"],
      "@rakun-kit/core/manager": ["../core/src/manager.ts"],
      "@rakun-kit/core/internal-content-types": [
        "../core/src/internal-content-types/index.ts"
      ],
      "@rakun-kit/core/internal-content-types/*": [
        "../core/src/internal-content-types/*.ts"
      ],
      "@rakun-kit/core/types": ["../core/src/lib/types/index.ts"],
      "@rakun-kit/jsx-email": ["../jsx-email/src/index.ts"],
      "@rakun-kit/manager-react": ["../manager-react/src/index.ts"],
      "@rakun-kit/manager-locales/es": ["../manager-locales/src/es.ts"],
      "@rakun-kit/manager-react/*": ["../manager-react/src/*"],
      "@rakun-kit/resend": ["../resend/src/index.ts"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "server", "emails", "scripts", "vite.config.ts"]
}
