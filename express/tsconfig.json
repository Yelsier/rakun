{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "rootDir": "..",
    "outDir": "dist",
    "noEmit": true,
    "paths": {
      "@rakun-kit/core": ["../core/src/index.ts"],
      "@rakun-kit/core/contracts": ["../core/src/contracts.ts"],
      "@rakun-kit/core/errors": ["../core/src/lib/errors/index.ts"],
      "@rakun-kit/core/logger": ["../core/src/lib/Logger.ts"],
      "@rakun-kit/trpc": ["../trpc/src/index.ts"]
    }
  },
  "include": ["src"]
}
