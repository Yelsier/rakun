{
  "name": "@rakun-kit/smtp",
  "version": "1.0.0",
  "description": "SMTP mail adapter for Rakun.",
  "license": "MIT",
  "author": {
    "name": "Yago Claros",
    "url": "https://github.com/Yelsier"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yelsier/rakun.git",
    "directory": "smtp"
  },
  "bugs": {
    "url": "https://github.com/Yelsier/rakun/issues"
  },
  "homepage": "https://github.com/Yelsier/rakun/tree/main/smtp#readme",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && bun run build:esm && bun run build:cjs && node ../scripts/copy-package-docs.mjs",
    "build:esm": "tsc -p tsconfig.build.json && node ../scripts/fix-dist-imports.mjs dist/esm",
    "build:cjs": "rm -rf dist/cjs && tsc -p tsconfig.build.cjs.json && node ../scripts/write-cjs-package-json.mjs dist/cjs",
    "test": "bun test"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "nodemailer": "^9.0.3"
  },
  "peerDependencies": {
    "@rakun-kit/core": "^1.5.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  }
}
