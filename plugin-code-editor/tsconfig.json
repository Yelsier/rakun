{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@rakun-kit/core": ["../core/src/index.ts"],
      "@rakun-kit/core/client": ["../core/src/client.ts"],
      "@rakun-kit/core/manager": ["../core/src/manager.ts"],
      "@rakun-kit/core/types": ["../core/src/lib/types/index.ts"],
      "@rakun-kit/manager-react": ["../manager-react/src/index.ts"],
      "@rakun-kit/manager-react/plugins": ["../manager-react/src/plugins.tsx"],
      "@rakun-kit/manager-react/state/theme": ["../manager-react/src/state/theme.tsx"]
    }
  },
  "include": ["src"]
}
